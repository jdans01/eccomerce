<div class="section-padding page-width">
  <div class="rich-text">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="section-subtitle">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div style="margin-top:20px;">
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Texto enriquecido",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Calidad en cada detalle" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Seleccionamos cada material y cada proceso pensando en durabilidad, comodidad y estilo.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [
    { "name": "Texto enriquecido" }
  ]
}
{% endschema %}
