{%- liquid
  assign feature_product = section.settings.product
-%}
<div class="section-padding page-width">
  <div class="section-header" style="justify-content:center;text-align:center;">
    <div class="section-header__text" style="margin:0 auto;">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="section-subtitle">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </div>

  <div class="feature-grid">
    {%- for image in feature_product.images limit: 3 -%}
      <div class="feature-grid__item">
        <img
          src="{{ image | image_url: width: 900 }}"
          srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w"
          sizes="(min-width: 990px) 33vw, 100vw"
          alt="{{ image.alt | escape }}"
          loading="lazy"
          width="{{ image.width }}"
          height="{{ image.height }}"
        >
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Galería de detalles",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Cada detalle cuenta" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tecnología pensada para durar" },
    { "type": "textarea", "id": "text", "label": "Texto" }
  ],
  "presets": [ { "name": "Galería de detalles" } ]
}
{% endschema %}
