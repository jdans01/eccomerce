{%- if section.blocks.size > 0 -%}
<div class="announcement-bar" data-announcement-bar data-autorotate="{{ section.settings.autorotate }}" data-speed="{{ section.settings.autorotate_speed | times: 1000 }}">
  <div class="announcement-bar__track">
    {%- for block in section.blocks -%}
      <div class="announcement-bar__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          <span>{{ block.settings.text }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "settings": [
    {
      "type": "checkbox",
      "id": "autorotate",
      "label": "Rotar automáticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "label": "Velocidad (segundos)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anuncio",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío gratis en pedidos superiores a $75"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ]
}
{% endschema %}
