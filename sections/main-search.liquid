<div class="page-width section-padding">
  <div class="collection-header" style="margin-bottom:32px;">
    <h1>{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="state-page__search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn btn--primary">{{ 'general.search.submit' | t }}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <p style="margin-bottom:20px;color:var(--color-text-light);">{{ search.results_count }} {{ 'general.search.results_for' | t }} “{{ search.terms }}”</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'product-card', product: item -%}
          {%- else -%}
            <a href="{{ item.url }}" class="product-card">
              <div class="product-card__info">
                <h3 class="product-card__title">{{ item.title }}</h3>
                <p class="section-subtitle">{{ item.content | strip_html | truncatewords: 15 }}</p>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- paginate search.results by 24 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="empty-state">
        <h3>{{ 'general.search.no_results' | t }}</h3>
        <p class="section-subtitle">{{ 'general.search.no_results_text' | t }}</p>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Búsqueda", "settings": [] }
{% endschema %}
