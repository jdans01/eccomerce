<div class="section-padding page-width">
  {%- liquid
    assign side_image = section.settings.image
    if side_image == blank and section.settings.product != blank
      assign image_index = section.settings.image_index | default: 1 | minus: 1
      assign side_image = section.settings.product.images[image_index]
    endif
  -%}
  <div class="image-with-text{% if section.settings.layout == 'reverse' %} image-with-text--reverse{% endif %}">
    <div class="image-with-text__media">
      {%- if side_image -%}
        <img src="{{ side_image | image_url: width: 1200 }}" alt="{{ side_image.alt | escape }}" loading="lazy" width="{{ side_image.width }}" height="{{ side_image.height }}">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="image-with-text__content">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--secondary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Imagen con texto",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "product", "id": "product", "label": "Producto (usa una de sus fotos si no eliges una imagen arriba)" },
    { "type": "range", "id": "image_index", "label": "Qué foto del producto usar", "min": 1, "max": 6, "step": 1, "default": 1 },
    { "type": "select", "id": "layout", "label": "Diseño", "options": [{ "value": "default", "label": "Imagen a la izquierda" }, { "value": "reverse", "label": "Imagen a la derecha" }], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Nuestra historia" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Hecho para durar" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Trabajamos con talleres locales y materiales responsables para crear productos honestos, sin atajos." },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [
    { "name": "Imagen con texto" }
  ]
}
{% endschema %}
