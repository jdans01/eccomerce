<div class="page-width section-padding">
  <div class="section-header" style="justify-content:center;text-align:center;">
    <div class="section-header__text" style="margin:0 auto;">
      <h1>{{ 'general.collections.all_title' | t }}</h1>
    </div>
  </div>
  <div class="collection-grid">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="collection-card">
        {%- if collection.featured_image -%}
          <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" loading="lazy">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag }}
        {%- endif -%}
        <div class="collection-card__scrim"></div>
        <div class="collection-card__label">
          <h3>{{ collection.title }}</h3>
          <span>{{ collection.products_count }} {{ 'general.collections.products' | t }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Todas las colecciones", "settings": [] }
{% endschema %}
