<div class="page-width section-padding">
  <div class="section-header" style="justify-content:center;text-align:center;">
    <div class="section-header__text" style="margin:0 auto;">
      <h1>{{ blog.title }}</h1>
    </div>
  </div>

  <div class="blog-grid">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" class="article-card">
        <div class="article-card__image">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="article-card__date">{{ article.published_at | date: '%d %B %Y' }}</div>
        <h3 class="article-card__title">{{ article.title }}</h3>
        <p class="section-subtitle">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
      </a>
    {%- endfor -%}
  </div>

  {%- paginate blog.articles by 12 -%}
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
