<div class="section-padding page-width">
  <div class="section-header" style="justify-content:center;text-align:center;">
    <div class="section-header__text" style="margin:0 auto;">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
  </div>

  <div class="faq" data-faq>
    {%- for block in section.blocks -%}
      <div class="faq-item" {{ block.shopify_attributes }}>
        <button type="button" class="faq-item__question">
          <span>{{ block.settings.question }}</span>
          <span class="faq-item__icon">{% render 'icon', name: 'plus' %}</span>
        </button>
        <div class="faq-item__answer">
          <div class="faq-item__answer-inner">{{ block.settings.answer }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Preguntas frecuentes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Ayuda" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Cuánto tarda el envío?" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Los pedidos se procesan en 1-2 días hábiles y llegan en 3-5 días hábiles.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Preguntas frecuentes",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
