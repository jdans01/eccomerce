{%- assign featured_product = section.settings.product -%}
<div class="section-padding page-width">
  <div class="image-with-text{% if section.settings.layout == 'reverse' %} image-with-text--reverse{% endif %}">
    <div class="image-with-text__media">
      {%- if featured_product.featured_image -%}
        <img
          src="{{ featured_product.featured_image | image_url: width: 1200 }}"
          srcset="{{ featured_product.featured_image | image_url: width: 600 }} 600w, {{ featured_product.featured_image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 990px) 50vw, 100vw"
          alt="{{ featured_product.featured_image.alt | escape }}"
          loading="lazy"
          width="{{ featured_product.featured_image.width }}"
          height="{{ featured_product.featured_image.height }}"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="image-with-text__content">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | default: featured_product.title }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if featured_product -%}
        <div style="margin-bottom:20px;">{%- render 'price', product: featured_product -%}</div>
      {%- endif -%}
      <a href="{{ featured_product.url | default: '#' }}" class="btn btn--secondary">{{ section.settings.button_label }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Producto destacado",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "select", "id": "layout", "label": "Diseño", "options": [{ "value": "default", "label": "Imagen a la izquierda" }, { "value": "reverse", "label": "Imagen a la derecha" }], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior" },
    { "type": "text", "id": "heading", "label": "Título (si se deja vacío, usa el del producto)" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar ahora" }
  ],
  "presets": [ { "name": "Producto destacado" } ]
}
{% endschema %}
