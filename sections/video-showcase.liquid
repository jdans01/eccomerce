{%- liquid
  assign showcase_product = section.settings.product
  assign showcase_video = null
  for media in showcase_product.media
    if media.media_type == 'video' and showcase_video == null
      assign showcase_video = media
    endif
  endfor
-%}
<div class="section-padding page-width">
  <div class="video-showcase">
    {%- if showcase_video -%}
      {%- liquid
        assign video_src = ''
        for source in showcase_video.sources
          if source.format == 'mp4' and source.width == 720
            assign video_src = source.url
          endif
        endfor
        if video_src == ''
          assign video_src = showcase_video.sources[0].url
        endif
      -%}
      <video class="video-showcase__media" autoplay muted loop playsinline poster="{{ showcase_video.preview_image | image_url: width: 1600 }}">
        <source src="{{ video_src }}" type="video/mp4">
      </video>
    {%- elsif showcase_product.featured_image -%}
      <img class="video-showcase__media" src="{{ showcase_product.featured_image | image_url: width: 1600 }}" alt="{{ showcase_product.title | escape }}" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
    <div class="video-showcase__scrim"></div>
    <div class="video-showcase__content">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ showcase_product.url | default: '#' }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video del producto",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto (muestra su video si tiene uno)" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Míralo en acción" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar ahora" }
  ],
  "presets": [ { "name": "Video del producto" } ]
}
{% endschema %}
