<div class="section-padding page-width" id="specs">
  <div class="specs-block">
    <div class="specs-block__text">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="section-subtitle">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="specs-table">
      {%- for block in section.blocks -%}
        <div class="specs-table__row" {{ block.shopify_attributes }}>
          <span class="specs-table__label">{{ block.settings.label }}</span>
          <span class="specs-table__value">{{ block.settings.value }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Especificaciones",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Detalles técnicos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Especificaciones" },
    { "type": "textarea", "id": "text", "label": "Texto" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Especificación",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre", "default": "Material" },
        { "type": "text", "id": "value", "label": "Valor", "default": "Aleación de aluminio + silicona" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Especificaciones",
      "blocks": [
        { "type": "spec" },
        { "type": "spec" },
        { "type": "spec" }
      ]
    }
  ]
}
{% endschema %}
