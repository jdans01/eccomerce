<div class="collection-header">
  <div class="page-width">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="section-subtitle" style="max-width:640px;margin:10px auto 0;">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

<div class="page-width section-padding" style="padding-top:0;">
  <div class="collection-layout">
    {%- if section.settings.show_filters -%}
      <aside>
        <form id="CollectionFilterForm">
          {%- for filter in collection.filters -%}
            <div class="filter-group">
              <div class="filter-group__title">{{ filter.label }}</div>
              {%- if filter.type == 'price_range' -%}
                <div style="display:flex;gap:8px;">
                  <input type="number" class="form-field" name="{{ filter.min_value.param_name }}" placeholder="{{ 'general.filters.min' | t }}" value="{{ filter.min_value.value }}" style="width:50%;padding:8px;border:1px solid var(--color-border);border-radius:8px;">
                  <input type="number" name="{{ filter.max_value.param_name }}" placeholder="{{ 'general.filters.max' | t }}" value="{{ filter.max_value.value }}" style="width:50%;padding:8px;border:1px solid var(--color-border);border-radius:8px;">
                </div>
              {%- else -%}
                {%- for value in filter.values -%}
                  <label class="filter-option">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} onchange="this.form.submit()">
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
          <button type="submit" class="btn btn--secondary btn--sm btn--full">{{ 'general.filters.apply' | t }}</button>
        </form>
      </aside>
    {%- endif -%}

    <div>
      <div class="collection-toolbar">
        <span>{{ collection.products_count }} {{ 'general.collections.products' | t }}</span>
        <form id="CollectionSortForm">
          <select name="sort_by" class="sort-select" onchange="this.form.submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>
        {%- paginate collection.products by 24 -%}
          {%- render 'pagination', paginate: paginate -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="empty-state">
          <h3>{{ 'general.collections.empty' | t }}</h3>
          <p class="section-subtitle">{{ 'general.collections.empty_text' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="margin-top:16px;">{{ 'general.collections.view_all' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "checkbox", "id": "show_filters", "label": "Mostrar filtros", "default": true }
  ]
}
{% endschema %}
