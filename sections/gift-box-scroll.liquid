<div class="gift-box-scroll" data-gift-box style="--gift-scroll-height: {{ section.settings.scene_height | default: 320 }}vh;">
  <div class="gift-box-scroll__stage">
    <div class="gift-box-scroll__glow" aria-hidden="true"></div>

    <div class="gift-box-scroll__header page-width">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow reveal is-visible">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="gift-box-scroll__heading reveal is-visible">
        {{ section.settings.heading }}
        {%- if section.settings.accent_word != blank -%}
          <em class="gift-box-scroll__accent">{{ section.settings.accent_word }}</em>
        {%- endif -%}
        {%- if section.settings.heading_line2 != blank -%}
          <span class="gift-box-scroll__heading-line2">{{ section.settings.heading_line2 }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="gift-box-scroll__text reveal is-visible">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="gift-box-scroll__scene">
      <div class="gift-box" data-gift-box-graphic aria-hidden="true">
        <div class="gift-box__base"></div>
        <div class="gift-box__lid" data-gift-lid>
          <div class="gift-box__ribbon-h"></div>
          <div class="gift-box__bow">
            <span></span><span></span>
            <i></i>
          </div>
        </div>
        <div class="gift-box__ribbon-v"></div>
      </div>

      {%- for block in section.blocks -%}
        {%- assign item_product = block.settings.product -%}
        <div class="gift-item" data-gift-item {{ block.shopify_attributes }}>
          {%- if item_product != blank -%}
            <a href="{{ item_product.url }}" class="gift-item__link">
              <span class="gift-item__image">
                {%- if item_product.featured_image -%}
                  <img src="{{ item_product.featured_image | image_url: width: 400 }}" alt="{{ item_product.featured_image.alt | escape }}" loading="lazy" width="200" height="200">
                {%- endif -%}
              </span>
            </a>
            <div class="gift-item__caption" data-gift-caption>
              <span class="gift-item__name">{{ item_product.title }}</span>
              <span class="gift-item__price">{{ item_product.price | money }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Caja de regalo (scroll)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Una experiencia para desenvolver" },
    { "type": "text", "id": "heading", "label": "Título (antes de la palabra destacada)", "default": "Porque mereces" },
    { "type": "text", "id": "accent_word", "label": "Palabra destacada (cursiva, color de acento)", "default": "consentirte" },
    { "type": "text", "id": "heading_line2", "label": "Título (línea siguiente)", "default": "sin esperar una razón" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Herramientas profesionales, elegidas para la mujer que no espera una ocasión para sentirse así de bien. Desliza para descubrirlas." },
    { "type": "range", "id": "scene_height", "label": "Altura del recorrido de scroll", "min": 240, "max": 420, "step": 20, "unit": "vh", "default": 320 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Producto",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto" }
      ]
    }
  ],
  "presets": [
    { "name": "Caja de regalo (scroll)" }
  ]
}
{% endschema %}
