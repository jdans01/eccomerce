{%- liquid
  assign product = product
  assign current_variant = product.selected_or_first_available_variant
-%}
<div class="page-width">
  <div class="product-main">
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery__main" data-gallery-main>
        {%- if current_variant.featured_image -%}
          <img src="{{ current_variant.featured_image | image_url: width: 1200 }}" alt="{{ current_variant.featured_image.alt | escape }}" id="ProductMainImage" width="{{ current_variant.featured_image.width }}" height="{{ current_variant.featured_image.height }}">
        {%- elsif product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape }}" id="ProductMainImage" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'video' -%}
              {%- liquid
                assign video_src = ''
                for source in media.sources
                  if source.format == 'mp4' and source.width == 720
                    assign video_src = source.url
                  endif
                endfor
                if video_src == ''
                  assign video_src = media.sources[0].url
                endif
              -%}
              <button type="button" class="product-gallery__thumb" data-gallery-thumb data-media-id="{{ media.id }}" data-media-type="video" data-video-src="{{ video_src }}" data-poster="{{ media.preview_image | image_url: width: 1200 }}" aria-label="{{ 'products.product.view_video' | t }}">
                <img src="{{ media.preview_image | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy">
                <span class="product-gallery__play-badge">{% render 'icon', name: 'play' %}</span>
              </button>
            {%- else -%}
              <button type="button" class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-thumb data-media-id="{{ media.id }}" data-media-type="image" data-full-src="{{ media | image_url: width: 1200 }}" aria-label="{{ 'products.product.view_image' | t }} {{ forloop.index }}">
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy">
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      {%- if product.vendor != blank -%}<div class="product-info__vendor">{{ product.vendor }}</div>{%- endif -%}
      <h1 class="product-info__title">{{ product.title }}</h1>

      {%- if section.settings.show_rating -%}
        <div class="product-info__rating">
          <span class="stars">{%- for i in (1..5) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</span>
          <span>{{ 'products.product.reviews_placeholder' | t }}</span>
        </div>
      {%- endif -%}

      <div data-product-price>
        {%- render 'price', product: product, variant: current_variant -%}
      </div>

      {%- if product.description != blank -%}
        {%- liquid
          assign clean_description = product.description | strip_html | strip_newlines
          assign description_items = clean_description | split: '✅'
        -%}
        {%- if description_items.size > 1 -%}
          <ul class="product-info__feature-list">
            {%- for item in description_items -%}
              {%- assign trimmed_item = item | strip -%}
              {%- if trimmed_item != blank -%}
                <li>{% render 'icon', name: 'check' %}<span>{{ trimmed_item }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="product-info__description">{{ clean_description | truncatewords: 40 }}</div>
        {%- endif -%}
      {%- endif -%}

      <product-form data-product-form>
        <script type="application/json" data-variant-json>
          {{ product.variants | json }}
        </script>
        <form data-add-to-cart-form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {%- for option in product.options_with_values -%}
            <div class="option-selector">
              <div class="option-selector__label">
                <span>{{ option.name }}</span>
                <span class="current-value" data-current-value="{{ forloop.index }}">{{ option.selected_value }}</span>
              </div>
              <div class="option-values">
                {%- assign is_color = false -%}
                {%- if option.name == 'Color' or option.name == 'Colour' -%}{%- assign is_color = true -%}{%- endif -%}
                {%- for value in option.values -%}
                  {%- liquid
                    assign input_id = option.position | append: '-' | append: forloop.index
                    assign checked = false
                    if value == option.selected_value
                      assign checked = true
                    endif
                  -%}
                  <label class="{% if is_color %}option-swatch{% else %}option-pill{% endif %}{% if checked %} is-selected{% endif %}"
                    {% if is_color %}style="background:{{ value | handleize }};"{% endif %}
                    title="{{ value }}">
                    <input
                      type="radio"
                      name="option-{{ option.position }}"
                      value="{{ value | escape }}"
                      data-option-input
                      data-option-position="{{ option.position }}"
                      {% if checked %}checked{% endif %}
                      class="visually-hidden"
                    >
                    {%- unless is_color -%}{{ value }}{%- endunless -%}
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          <div class="option-selector">
            <div class="option-selector__label"><span>{{ 'products.product.quantity' | t }}</span></div>
            <div class="quantity-selector" data-quantity-selector>
              <button type="button" data-qty-decrease aria-label="{{ 'cart.general.decrease' | t }}">−</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
              <button type="button" data-qty-increase aria-label="{{ 'cart.general.increase' | t }}">+</button>
            </div>
          </div>

          <p class="form-error" data-form-error hidden></p>

          <div class="product-form__buy">
            <button type="submit" class="btn btn--primary" data-submit-button {% unless current_variant.available %}disabled{% endunless %}>
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>
        </form>
      </product-form>

      <div class="product-info__meta">
        <div class="product-info__meta-item">{% render 'icon', name: 'truck' %}<span>{{ 'products.product.shipping_info' | t }}</span></div>
        <div class="product-info__meta-item">{% render 'icon', name: 'refresh' %}<span>{{ 'products.product.returns_info' | t }}</span></div>
        <div class="product-info__meta-item">{% render 'icon', name: 'shield' %}<span>{{ 'products.product.secure_checkout' | t }}</span></div>
      </div>

      <div class="accordion" data-accordion>
        {%- if product.description != blank -%}
          <div class="accordion-item">
            <button type="button" class="accordion-item__trigger"><span>{{ 'products.product.details' | t }}</span><span class="accordion-item__icon">{% render 'icon', name: 'plus' %}</span></button>
            <div class="accordion-item__panel"><div class="accordion-item__panel-inner">{{ product.description }}</div></div>
          </div>
        {%- endif -%}
        <div class="accordion-item">
          <button type="button" class="accordion-item__trigger"><span>{{ 'products.product.shipping_returns' | t }}</span><span class="accordion-item__icon">{% render 'icon', name: 'plus' %}</span></button>
          <div class="accordion-item__panel"><div class="accordion-item__panel-inner">{{ section.settings.shipping_returns_text }}</div></div>
        </div>
        <div class="accordion-item">
          <button type="button" class="accordion-item__trigger"><span>{{ 'products.product.care' | t }}</span><span class="accordion-item__icon">{% render 'icon', name: 'plus' %}</span></button>
          <div class="accordion-item__panel"><div class="accordion-item__panel-inner">{{ section.settings.care_text }}</div></div>
        </div>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.show_related -%}
  {%- assign related_type_handle = product.type | handleize -%}
  {%- assign related = collections[related_type_handle].products | default: collections.all.products -%}
  <div class="related-products page-width section-padding">
    <div class="section-header">
      <div class="section-header__text"><h2>{{ 'products.product.related_products' | t }}</h2></div>
    </div>
    <div class="product-grid">
      {%- for p in related limit: 4 -%}
        {%- unless p.handle == product.handle -%}
          {%- render 'product-card', product: p -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Producto",
  "settings": [
    { "type": "checkbox", "id": "show_rating", "label": "Mostrar calificación", "default": true },
    { "type": "checkbox", "id": "show_related", "label": "Mostrar productos relacionados", "default": true },
    { "type": "richtext", "id": "shipping_returns_text", "label": "Texto de envío y devoluciones", "default": "<p>Envío estándar de 3 a 5 días hábiles. Devoluciones gratuitas dentro de los primeros 30 días.</p>" },
    { "type": "richtext", "id": "care_text", "label": "Texto de cuidado del producto", "default": "<p>Lavar a mano con agua fría. Secar a la sombra.</p>" }
  ]
}
{% endschema %}
