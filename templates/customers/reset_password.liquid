<div class="page-width section-padding">
  <div class="form-narrow">
    <h1 style="text-align:center;margin-bottom:16px;">{{ 'customer.reset_password.title' | t }}</h1>
    <p class="section-subtitle" style="text-align:center;margin-bottom:24px;">{{ 'customer.reset_password.text' | t }}</p>
    {%- form 'reset_customer_password' -%}
      <div class="form-field">
        <label for="ResetPassword">{{ 'customer.register.password' | t }}</label>
        <input type="password" id="ResetPassword" name="customer[password]" required>
      </div>
      <div class="form-field">
        <label for="ResetPasswordConfirmation">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input type="password" id="ResetPasswordConfirmation" name="customer[password_confirmation]" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
