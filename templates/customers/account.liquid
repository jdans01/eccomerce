<div class="page-width section-padding">
  <div class="collection-toolbar">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" class="link">{{ 'customer.account.logout' | t }}</a>
  </div>

  <div class="collection-layout" style="grid-template-columns: 2fr 1fr;">
    <div>
      <h3 style="margin-bottom:16px;">{{ 'customer.orders.title' | t }}</h3>
      {%- if customer.orders.size == 0 -%}
        <p class="section-subtitle">{{ 'customer.orders.none' | t }}</p>
      {%- else -%}
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:1px solid var(--color-border);text-align:left;">
              <th style="padding:10px 0;">{{ 'customer.orders.order_number' | t }}</th>
              <th>{{ 'customer.orders.date' | t }}</th>
              <th>{{ 'customer.orders.payment_status' | t }}</th>
              <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
              <th>{{ 'customer.orders.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr style="border-bottom:1px solid var(--color-border);">
                <td style="padding:14px 0;"><a href="{{ order.customer_url }}" class="link">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- endif -%}
    </div>

    <div>
      <h3 style="margin-bottom:16px;">{{ 'customer.addresses.title' | t }}</h3>
      {%- if customer.default_address -%}
        <p class="section-subtitle">
          {{ customer.default_address.address1 }}<br>
          {{ customer.default_address.city }}, {{ customer.default_address.province_code }} {{ customer.default_address.zip }}<br>
          {{ customer.default_address.country }}
        </p>
      {%- else -%}
        <p class="section-subtitle">{{ 'customer.addresses.none' | t }}</p>
      {%- endif -%}
      <a href="{{ routes.account_addresses_url }}" class="btn btn--secondary btn--sm" style="margin-top:12px;">{{ 'customer.addresses.manage' | t }}</a>
    </div>
  </div>
</div>
