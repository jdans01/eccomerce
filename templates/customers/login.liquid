<div class="page-width section-padding">
  <div class="form-narrow">
    <h1 style="text-align:center;margin-bottom:32px;">{{ 'customer.login.title' | t }}</h1>

    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div id="CustomerLoginForm">
        <div class="form-field">
          <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
        </div>

        {%- unless form.password_needed == false -%}
          <div class="form-field">
            <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
            <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password">
          </div>
        {%- endunless -%}

        <button type="submit" class="btn btn--primary btn--full">{{ 'customer.login.sign_in' | t }}</button>

        <div style="text-align:center;margin-top:18px;">
          <a href="#recover" class="link" data-recover-toggle>{{ 'customer.login.forgot_password' | t }}</a>
        </div>
      </div>

      <div id="RecoverPasswordForm" style="display:none;">
        <p class="section-subtitle">{{ 'customer.recover.text' | t }}</p>
        <div class="form-field">
          <label for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="RecoverEmail" name="customer[email]">
        </div>
        <button type="submit" name="recover_customer_password" class="btn btn--primary btn--full">{{ 'customer.recover.submit' | t }}</button>
        <div style="text-align:center;margin-top:18px;">
          <a href="#" class="link" data-recover-toggle>{{ 'customer.recover.cancel' | t }}</a>
        </div>
      </div>
    {%- endform -%}

    {%- if shop.checkout.guest_login -%}
      {%- form 'guest_login' -%}
        <button type="submit" class="btn btn--secondary btn--full" style="margin-top:14px;">{{ 'customer.login.guest_continue' | t }}</button>
      {%- endform -%}
    {%- endif -%}

    <p style="text-align:center;margin-top:24px;color:var(--color-text-light);">
      {{ 'customer.login.no_account' | t }} <a href="{{ routes.account_register_url }}" class="link">{{ 'customer.login.create_account' | t }}</a>
    </p>
  </div>
</div>

<script>
  document.querySelectorAll('[data-recover-toggle]').forEach(function (link) {
    link.addEventListener('click', function (e) {
      e.preventDefault();
      var login = document.getElementById('CustomerLoginForm');
      var recover = document.getElementById('RecoverPasswordForm');
      var showRecover = recover.style.display === 'none';
      recover.style.display = showRecover ? 'block' : 'none';
      login.style.display = showRecover ? 'none' : 'block';
    });
  });
  {% if form.errors and form.password_needed == false %}
    document.getElementById('CustomerLoginForm').style.display = 'none';
    document.getElementById('RecoverPasswordForm').style.display = 'block';
  {% endif %}
</script>
