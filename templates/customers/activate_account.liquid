<div class="page-width section-padding">
  <div class="form-narrow">
    <h1 style="text-align:center;margin-bottom:16px;">{{ 'customer.activate_account.title' | t }}</h1>
    <p class="section-subtitle" style="text-align:center;margin-bottom:24px;">{{ 'customer.activate_account.text' | t }}</p>
    {%- form 'activate_customer_password' -%}
      <div class="form-field">
        <label for="Password">{{ 'customer.register.password' | t }}</label>
        <input type="password" id="Password" name="customer[password]" required>
      </div>
      <div class="form-field">
        <label for="PasswordConfirmation">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input type="password" id="PasswordConfirmation" name="customer[password_confirmation]" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full" name="accept">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" class="btn btn--secondary btn--full" name="decline" style="margin-top:10px;">{{ 'customer.activate_account.decline' | t }}</button>
    {%- endform -%}
  </div>
</div>
